{
    "rewrites": [
        {
            "source": "/api/:path*",
            "destination": "/api"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "functions": {
        "api/index.js": {
            "memory": 1024,
            "maxDuration": 60
        }
    },
    "crons": [
        {
            "path": "/api/cron/reminders",
            "schedule": "0 8 * * *"
        }
    ]
}