# =========================================
# Patient Record System Environment Variables
# =========================================

# Supabase Configuration (Required)
# Get these from your Supabase project: Dashboard -> Settings -> API

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# =========================================
# Frontend Key (exposed to browser via Vite)
# =========================================
# Publishable Key - safe for client-side use
# Format: sb_publishable_xxxxxxxx
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# =========================================
# Backend Key (Server-side only - NEVER expose to client)
# =========================================
# Secret Key - automatically blocked in browsers
# Format: sb_secret_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# =========================================
# Server Configuration
# =========================================
PORT=3000
NODE_ENV=development

# JWT Secret (for server-side token signing)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key

# =========================================
# Optional: Email Service Configuration
# =========================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-app-password

# =========================================
# Optional: Additional Settings
# =========================================
# VITE_APP_NAME=Patient Record System
# VITE_API_BASE_URL=http://localhost:3000/api