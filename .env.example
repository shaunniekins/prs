# =========================================
# Patient Record System Environment Variables
# =========================================

# Supabase Configuration (Required)
# Get these from your Supabase project: Dashboard -> Settings -> API

# Supabase Project URL
VITE_SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_URL=https://your-project-id.supabase.co

# =========================================
# Frontend Key (exposed to browser via Vite)
# =========================================
# Publishable Key - safe for client-side use
# Format: sb_publishable_xxxxxxxx
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-publishable-key

# =========================================
# Backend Key (Server-side only - NEVER expose to client)
# =========================================
# Secret Key - automatically blocked in browsers
# Format: sb_secret_xxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_your-secret-key

# =========================================
# Server Configuration
# =========================================
PORT=3000
NODE_ENV=development

# JWT Secret (for server-side token signing)
# Generate with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-key

# --- Gmail App Password ---
# To get an App Password:
# 1. Go to https://myaccount.google.com/security
# 2. Enable 2-Step Verification if not already on
# 3. Go to "App passwords" (search for it if not visible)
# 4. Generate a new password (app: Mail, device: Other)
GMAIL_USER=your_email_here
GMAIL_APP_PASSWORD=your_app_password_here
SMTP_FROM=your_email_here



# =========================================
# Optional: Additional Settings
# =========================================
# VITE_APP_NAME=Patient Record System
# VITE_API_BASE_URL=http://localhost:3000/api